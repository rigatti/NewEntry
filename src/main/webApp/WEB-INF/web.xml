<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="
           http://xmlns.jcp.org/xml/ns/javaee
           http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
		 version="3.1">

	<display-name>Belex</display-name>

	<!-- Initializer -->
	<servlet>
		<servlet-name>cleanUp</servlet-name>
		<servlet-class>org.belex.application.InitializerServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>

	<!-- Spring context -->
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>/WEB-INF/flow-servlet.xml</param-value>
	</context-param>

	<!-- Filtre Hibernate Session (Open Session In View) -->
	<filter>
		<filter-name>openSessionInViewFilter</filter-name>
		<filter-class>org.springframework.orm.hibernate5.support.OpenSessionInViewFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>openSessionInViewFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>

	<!-- DispatcherServlet -->
	<!-- Spring WebFlow Dispatcher -->
	<servlet>
		<servlet-name>flow</servlet-name>
		<servlet-class>
			org.springframework.web.servlet.DispatcherServlet
		</servlet-class>
		<load-on-startup>2</load-on-startup>
	</servlet>

	<servlet-mapping>
		<servlet-name>flow</servlet-name>
		<url-pattern>/flow/*</url-pattern>
	</servlet-mapping>

	<!-- Session -->
	<session-config>
		<session-timeout>30</session-timeout>
	</session-config>

	<!-- Welcome -->
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<!-- Error -->
	<error-page>
		<error-code>500</error-code>
		<location>/500.jsp</location>
	</error-page>

</web-app>
