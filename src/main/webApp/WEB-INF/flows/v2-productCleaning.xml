<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow
                          http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="cleaningAct">

    <var name="cleaning" class="org.belex.cleaning.Cleaning"/>

    <action-state id="cleaningAct">
        <evaluate expression="cleaningBusiness.cleanDb(flowScope.cleaning)" result="flowScope.cleaning"/>
        <transition on="success" to="confirmView"/>
    </action-state>

    <end-state id="confirmView" view="productCleaning/main"/>

</flow>
