<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow
                          http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      start-state="searchSupplierEntriesAct">

    <var name="allocation" class="org.belex.allocation.Allocation"/>
    <var name="requestParams" class="org.belex.requestparams.RequestParams"/>

    <on-start>
        <evaluate expression="requestParams.setDate(T(org.belex.util.Util).getNowFormated('yyyyMMdd'))"/>
    </on-start>

    <action-state id="searchSupplierEntriesAct">
        <evaluate expression="allocationBusiness.getSuppliersEntries(flowScope.allocation, flowScope.requestParams)"
                  result="flowScope.allocation"/>
        <transition on="success" to="mainView"/>
    </action-state>

    <view-state id="mainView" view="productAllocation/main">
        <transition on="search" to="searchSupplierEntriesAct">
            <evaluate expression="requestParamsFormAction.bindAndValidate(flowRequestContext)"/>
        </transition>
        <transition on="getEntryOrders" to="getEntriesToAllocateAct">
            <evaluate expression="requestParamsFormAction.bindAndValidate(flowRequestContext)"/>
        </transition>
    </view-state>

    <action-state id="getEntriesToAllocateAct">
        <evaluate expression="allocationBusiness.getEntriesToAllocate(flowScope.allocation, flowScope.requestParams)"
                  result="flowScope.allocation"/>
        <transition on="success" to="allocationFormView"/>
    </action-state>

    <view-state id="allocationFormView" view="productAllocation/allocationForm" model="allocation">
        <transition on="updateAllocation" to="updateAllocationAct">
            <evaluate expression="requestParamsFormAction.bindAndValidate(flowRequestContext)"/>
        </transition>
        <transition on="confirmAllocation" to="confirmAllocationAct"/>
        <transition on="generateReport" to="generateReportView">
            <evaluate expression="requestParamsFormAction.bindAndValidate(flowRequestContext)"/>
        </transition>
        <transition on="back" to="mainView"/>
    </view-state>

    <view-state id="generateReportView" view="productAllocation/generateReport"/>

    <action-state id="updateAllocationAct">
        <evaluate expression="allocationBusiness.updateAllocation(flowScope.allocation, flowScope.requestParams)"
                  result="flowScope.allocation"/>
        <transition on="success" to="allocationFormView"/>
    </action-state>

    <action-state id="confirmAllocationAct">
        <evaluate expression="allocationBusiness.confirmAllocation(flowScope.allocation)"
                  result="flowScope.allocation"/>
        <transition on="success" to="allocationFormView"/>
    </action-state>

</flow>
